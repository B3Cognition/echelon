{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Echelon Plan Conformance",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "findings", "sources"],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["pass", "needs_repair"]
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "severity", "artifact", "description"],
        "properties": {
          "id": {"type": "string"},
          "severity": {
            "type": "string",
            "enum": ["info", "warning", "repair_required"]
          },
          "artifact": {"type": "string"},
          "description": {"type": "string"},
          "required_repair": {"type": "string"}
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string"}
    }
  }
}
