{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Squad State",
  "type": "object",
  "required": [
    "run_id",
    "status",
    "phase",
    "iteration",
    "created_at"
  ],
  "properties": {
    "run_id": {
      "type": "string",
      "pattern": "^squad-[0-9]{3}-[0-9]+$"
    },
    "status": {
      "enum": [
        "build_init",
        "building",
        "build_done",
        "running",
        "blocked",
        "done",
        "error",
        "killed"
      ]
    },
    "phase": {
      "enum": [
        "build_init",
        "build_loop",
        "spec_guard",
        "code_review",
        "test_guard",
        "progress",
        "integration",
        "build_done",
        "init",
        "phase1-understand",
        "phase1-discover",
        "phase1-why1",
        "phase1-constitution",
        "phase1-what",
        "phase1-why2",
        "phase1-assess",
        "checkpoint-assess",
        "phase2-decide",
        "phase3-solution",
        "phase3-how",
        "phase3-specialists",
        "phase3-sentinel",
        "phase3-plan",
        "phase3-consensus",
        "checkpoint-plan",
        "phase4-document",
        "done"
      ]
    },
    "workflow_state": {
      "enum": [
        "TODO",
        "BUILD_IN_PROGRESS",
        "BUILD_COMPLETE",
        "QA_IN_PROGRESS",
        "QA_COMPLETE",
        "QA_FAILED",
        "REWORK_PLANNED",
        "CHANGE_PENDING",
        "BLOCKED",
        "OUT_OF_SCOPE",
        "ESCALATED"
      ]
    },
    "mode": {
      "enum": [
        "greenfield",
        "brownfield"
      ]
    },
    "constitution_status": {
      "enum": [
        "pending",
        "exists"
      ],
      "default": "pending"
    },
    "autonomy_mode": {
      "enum": [
        "guided",
        "semi",
        "banzai"
      ],
      "default": "semi"
    },
    "iteration": {
      "type": "integer",
      "minimum": 0,
      "maximum": 5
    },
    "spec_id": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "token_usage": {
      "type": "integer",
      "minimum": 0
    },
    "quality_scores": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "pass": {
            "type": "integer"
          },
          "overall": {
            "type": "number"
          },
          "structure": {
            "type": "number"
          },
          "testability": {
            "type": "number"
          }
        }
      }
    },
    "active_specialists": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "issues_log": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "severity": {
            "enum": [
              "CRITICAL",
              "HIGH",
              "MEDIUM",
              "LOW"
            ]
          },
          "source": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "resolved": {
            "type": "boolean"
          },
          "occurrences": {
            "type": "integer"
          }
        }
      }
    },
    "blocked_reason": {
      "type": "string"
    },
    "escalation_question": {
      "type": "string"
    },
    "dependency_checks": {
      "type": "object",
      "description": "Dependency availability checks keyed by dependency name.",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "available",
              "unavailable",
              "timeout",
              "incompatible"
            ]
          },
          "checked_at": {
            "type": "string",
            "format": "date-time"
          },
          "error_code": {
            "type": [
              "string",
              "null"
            ]
          },
          "version": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "status",
          "checked_at"
        ]
      },
      "default": {}
    },
    "fallback_mode": {
      "type": "boolean",
      "description": "True when a required dependency is unavailable and fallback behavior is active.",
      "default": false
    },
    "execution_mode": {
      "type": "string",
      "enum": [
        "standard",
        "manual_specification"
      ],
      "default": "standard"
    },
    "dependency_fallbacks": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "quality_degradation": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "dependency": {
            "type": "string"
          },
          "affected_artifacts": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "degradation_type": {
            "type": "string",
            "enum": [
              "unvalidated"
            ]
          }
        },
        "required": [
          "dependency",
          "affected_artifacts",
          "degradation_type"
        ]
      },
      "default": []
    },
    "recovery_mode": {
      "type": "boolean",
      "description": "True while the run is executing with recovered KB files.",
      "default": false
    },
    "phase_timings": {
      "type": "object",
      "description": "Timing telemetry captured for each phase transition.",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "start_ts": {
            "type": "string",
            "format": "date-time"
          },
          "end_ts": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "elapsed_seconds": {
            "type": "number",
            "minimum": 0
          },
          "budget_seconds": {
            "type": "number",
            "minimum": 0
          },
          "over_budget": {
            "type": "boolean"
          },
          "anomaly_reason": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "start_ts"
        ]
      },
      "default": {}
    },
    "checkpoints": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "phase": {
            "type": "string"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "decision": {
            "enum": [
              "PASS",
              "KILL",
              "DEFER",
              "SKIP"
            ]
          },
          "auto_defaulted": {
            "type": "boolean"
          }
        }
      }
    },
    "rework_iteration_count": {
      "type": "integer",
      "minimum": 0,
      "default": 0
    },
    "fallback_to_full_cycle": {
      "type": "boolean",
      "default": false
    },
    "escalation_reason": {
      "type": [
        "string",
        "null"
      ],
      "default": null
    },
    "change_resolution": {
      "type": "object",
      "properties": {
        "reentry_target": {
          "type": "string",
          "enum": [
            "BUILD_RESTART",
            "QA_RESTART"
          ]
        }
      }
    }
  }
}