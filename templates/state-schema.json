{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Squad State",
  "type": "object",
  "required": [
    "run_id",
    "status",
    "phase",
    "iteration",
    "created_at"
  ],
  "properties": {
    "run_id": {
      "type": "string",
      "pattern": "^squad-[0-9]{3}-[0-9]+$"
    },
    "status": {
      "enum": [
        "build_init",
        "building",
        "build_done",
        "running",
        "blocked",
        "done",
        "error",
        "killed"
      ]
    },
    "phase": {
      "enum": [
        "build_init",
        "build_loop",
        "spec_guard",
        "code_review",
        "test_guard",
        "progress",
        "integration",
        "build_done",
        "init",
        "phase1-understand",
        "phase1-discover",
        "phase1-why1",
        "phase1-constitution",
        "phase1-what",
        "phase1-why2",
        "phase1-assess",
        "checkpoint-assess",
        "phase2-decide",
        "phase3-solution",
        "phase3-how",
        "phase3-specialists",
        "phase3-sentinel",
        "phase3-plan",
        "phase3-consensus",
        "checkpoint-plan",
        "phase4-document",
        "done"
      ]
    },
    "workflow_state": {
      "enum": [
        "TODO",
        "BUILD_IN_PROGRESS",
        "BUILD_COMPLETE",
        "QA_IN_PROGRESS",
        "QA_COMPLETE",
        "QA_FAILED",
        "REWORK_PLANNED",
        "CHANGE_PENDING",
        "BLOCKED",
        "OUT_OF_SCOPE",
        "ESCALATED"
      ]
    },
    "mode": {
      "enum": [
        "greenfield",
        "brownfield"
      ]
    },
    "constitution_status": {
      "enum": [
        "pending",
        "exists"
      ],
      "default": "pending"
    },
    "autonomy_mode": {
      "enum": [
        "guided",
        "semi",
        "banzai"
      ],
      "default": "semi"
    },
    "iteration": {
      "type": "integer",
      "minimum": 0,
      "maximum": 5
    },
    "spec_id": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "token_usage": {
      "type": "integer",
      "minimum": 0
    },
    "quality_scores": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "pass": {
            "type": "integer"
          },
          "overall": {
            "type": "number"
          },
          "structure": {
            "type": "number"
          },
          "testability": {
            "type": "number"
          },
          "readability": {
            "type": "number"
          },
          "cognitive": {
            "type": "number"
          },
          "semantic": {
            "type": "number"
          },
          "behavioral": {
            "type": "number"
          },
          "depth": {
            "type": "number"
          }
        }
      }
    },
    "active_specialists": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "issues_log": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "severity": {
            "enum": [
              "CRITICAL",
              "HIGH",
              "MEDIUM",
              "LOW"
            ]
          },
          "source": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "resolved": {
            "type": "boolean"
          },
          "occurrences": {
            "type": "integer"
          }
        }
      }
    },
    "blocked_reason": {
      "type": "string"
    },
    "retarget": {
      "type": "object",
      "additionalProperties": false,
      "definitions": {
        "spec_id": {"type": "string", "pattern": "^(?:[0-9]{3,})-[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 1024},
        "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "receipt_text": {"type": ["string", "null"], "minLength": 1, "maxLength": 4096},
        "receipt_ids": {"type": "array", "maxItems": 1000, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 1024}},
        "memory_receipt": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "spec_id", "deleted_count", "deleted_ids", "drawer_set_digest", "mine_status", "audit_status", "adapter", "wing", "palace_path", "scanned_count", "delete_acknowledged_count", "remaining_owned_ids", "unrelated_missing_ids", "unrelated_changed_ids", "unexpected_added_ids", "report_set_digest", "failure_code"],
          "properties": {
            "status": {"enum": ["pass", "fail", "not_applicable"]},
            "spec_id": {"$ref": "#/properties/retarget/definitions/spec_id"},
            "deleted_count": {"type": "integer", "minimum": 0, "maximum": 1000},
            "deleted_ids": {"$ref": "#/properties/retarget/definitions/receipt_ids"},
            "drawer_set_digest": {"$ref": "#/properties/retarget/definitions/digest"},
            "mine_status": {"$ref": "#/properties/retarget/definitions/receipt_text"},
            "audit_status": {"$ref": "#/properties/retarget/definitions/receipt_text"},
            "adapter": {"$ref": "#/properties/retarget/definitions/receipt_text"},
            "wing": {"$ref": "#/properties/retarget/definitions/receipt_text"},
            "palace_path": {"$ref": "#/properties/retarget/definitions/receipt_text"},
            "scanned_count": {"type": "integer", "minimum": 0, "maximum": 1000},
            "delete_acknowledged_count": {"type": ["integer", "null"], "minimum": 0, "maximum": 1000},
            "remaining_owned_ids": {"$ref": "#/properties/retarget/definitions/receipt_ids"},
            "unrelated_missing_ids": {"$ref": "#/properties/retarget/definitions/receipt_ids"},
            "unrelated_changed_ids": {"$ref": "#/properties/retarget/definitions/receipt_ids"},
            "unexpected_added_ids": {"$ref": "#/properties/retarget/definitions/receipt_ids"},
            "report_set_digest": {"anyOf": [{"$ref": "#/properties/retarget/definitions/digest"}, {"type": "null"}]},
            "failure_code": {"$ref": "#/properties/retarget/definitions/receipt_text"}
          },
          "allOf": [
            {"if": {"properties": {"status": {"enum": ["pass", "not_applicable"]}}, "required": ["status"]}, "then": {"properties": {"failure_code": {"type": "null"}}}},
            {"if": {"properties": {"status": {"const": "pass"}}, "required": ["status"]}, "then": {"properties": {"report_set_digest": {"$ref": "#/properties/retarget/definitions/digest"}}}}
          ]
        },
        "graph_receipt": {
          "type": "object",
          "additionalProperties": false,
          "required": ["spec_id", "spec_status", "spec_graph_hash", "workspace_status", "workspace_graph_hash", "workspace_finding_codes"],
          "properties": {
            "spec_id": {"$ref": "#/properties/retarget/definitions/spec_id"},
            "spec_status": {"enum": ["invalidated", "pass", "warn"]},
            "spec_graph_hash": {"anyOf": [{"$ref": "#/properties/retarget/definitions/digest"}, {"type": "null"}]},
            "workspace_status": {"enum": ["pass", "warn", "fail", "unavailable", "not_applicable_empty_workspace"]},
            "workspace_graph_hash": {"anyOf": [{"$ref": "#/properties/retarget/definitions/digest"}, {"type": "null"}]},
            "workspace_finding_codes": {"type": "array", "maxItems": 1000, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*:(?:workspace|[0-9]{3,}-[a-z0-9]+(?:-[a-z0-9]+)*)$", "maxLength": 2048}}
          },
          "allOf": [
            {"if": {"properties": {"spec_status": {"const": "invalidated"}}, "required": ["spec_status"]}, "then": {"properties": {"spec_graph_hash": {"type": "null"}}}},
            {"if": {"properties": {"spec_status": {"enum": ["pass", "warn"]}}, "required": ["spec_status"]}, "then": {"properties": {"spec_graph_hash": {"$ref": "#/properties/retarget/definitions/digest"}}}},
            {"if": {"properties": {"workspace_status": {"const": "not_applicable_empty_workspace"}}, "required": ["workspace_status"]}, "then": {"properties": {"workspace_graph_hash": {"type": "null"}, "workspace_finding_codes": {"maxItems": 0}}}},
            {"if": {"properties": {"workspace_status": {"enum": ["pass", "warn", "fail", "unavailable"]}}, "required": ["workspace_status"]}, "then": {"properties": {"workspace_graph_hash": {"$ref": "#/properties/retarget/definitions/digest"}}}}
          ]
        }
      },
      "required": [
        "operation_id",
        "revision_id",
        "status",
        "baseline_run_id",
        "replacement_run_id",
        "old_targets",
        "replacement_targets",
        "checkpoint_id",
        "checkpoint_commit",
        "failure_code"
      ],
      "properties": {
        "operation_id": {"type": "string", "minLength": 1, "maxLength": 1024},
        "revision_id": {"type": "string", "maxLength": 1024},
        "baseline_run_id": {"type": "string", "maxLength": 1024},
        "replacement_run_id": {"type": "string", "maxLength": 1024},
        "checkpoint_id": {"type": "string", "maxLength": 1024},
        "checkpoint_commit": {"type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"},
        "replacement_commit": {"type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"},
        "old_targets": {"type": "array", "minItems": 1, "maxItems": 128, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 1024}},
        "replacement_targets": {"type": "array", "minItems": 1, "maxItems": 128, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 1024}},
        "status": {"enum": ["checkpointed", "invalidating", "rebuilding", "finalizing", "complete", "failed", "recovered"]},
        "memory_excluded": {"type": "boolean"},
        "memory_purge": {"$ref": "#/properties/retarget/definitions/memory_receipt"},
        "memory_finalization": {"$ref": "#/properties/retarget/definitions/memory_receipt"},
        "graph_invalidation": {"$ref": "#/properties/retarget/definitions/graph_receipt"},
        "graph_finalization": {"$ref": "#/properties/retarget/definitions/graph_receipt"},
        "finalization_receipt": {
          "type": "object",
          "additionalProperties": false,
          "required": ["revision_id", "completion_id", "checkpoint_commit", "replacement_targets", "memory", "graph", "replacement_commit", "status"],
          "properties": {
            "revision_id": {"type": "string", "minLength": 1, "maxLength": 1024},
            "completion_id": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
            "checkpoint_commit": {"type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"},
            "replacement_targets": {"type": "array", "minItems": 1, "maxItems": 128, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 1024}},
            "memory": {"$ref": "#/properties/retarget/definitions/memory_receipt"},
            "graph": {"$ref": "#/properties/retarget/definitions/graph_receipt"},
            "replacement_commit": {"type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"},
            "status": {"const": "complete"}
          }
        },
        "comparison_pending_completion_id": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
        "comparison_emitted_completion_id": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
        "comparison_event_id": {"type": "string", "pattern": "^retarget-comparison-[0-9a-f]{32}$"},
        "comparison_command": {"type": "string", "minLength": 1, "maxLength": 4096},
        "failure_code": {"type": ["string", "null"], "maxLength": 1024}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "complete"}}, "required": ["status"]},
          "then": {"required": ["memory_purge", "graph_invalidation", "memory_finalization", "graph_finalization", "replacement_commit", "finalization_receipt", "comparison_event_id", "comparison_command"], "anyOf": [{"required": ["comparison_pending_completion_id"]}, {"required": ["comparison_emitted_completion_id"]}]}
        },
        {
          "if": {"properties": {"status": {"const": "finalizing"}}, "required": ["status"]},
          "then": {"required": ["memory_excluded", "memory_purge", "graph_invalidation"], "not": {"anyOf": [{"required": ["memory_finalization"]}, {"required": ["graph_finalization"]}, {"required": ["replacement_commit"]}, {"required": ["finalization_receipt"]}, {"required": ["comparison_pending_completion_id"]}, {"required": ["comparison_emitted_completion_id"]}, {"required": ["comparison_event_id"]}, {"required": ["comparison_command"]}]}}
        },
        {
          "if": {"properties": {"status": {"enum": ["checkpointed", "invalidating", "rebuilding", "failed", "recovered"]}}, "required": ["status"]},
          "then": {"not": {"anyOf": [{"required": ["memory_finalization"]}, {"required": ["graph_finalization"]}, {"required": ["replacement_commit"]}, {"required": ["finalization_receipt"]}, {"required": ["comparison_pending_completion_id"]}, {"required": ["comparison_emitted_completion_id"]}, {"required": ["comparison_event_id"]}, {"required": ["comparison_command"]}]}}
        },
        {
          "if": {"properties": {"status": {"enum": ["rebuilding"]}}, "required": ["status"]},
          "then": {"required": ["memory_excluded", "memory_purge", "graph_invalidation"], "not": {"anyOf": [{"required": ["memory_finalization"]}, {"required": ["graph_finalization"]}, {"required": ["replacement_commit"]}, {"required": ["finalization_receipt"]}, {"required": ["comparison_pending_completion_id"]}, {"required": ["comparison_emitted_completion_id"]}, {"required": ["comparison_event_id"]}, {"required": ["comparison_command"]}]}}
        },
        {
          "if": {"properties": {"status": {"const": "checkpointed"}}, "required": ["status"]},
          "then": {"not": {"anyOf": [{"required": ["memory_excluded"]}, {"required": ["memory_purge"]}, {"required": ["graph_invalidation"]}, {"required": ["memory_finalization"]}, {"required": ["graph_finalization"]}]}}
        },
        {
          "if": {"properties": {"status": {"const": "invalidating"}}, "required": ["status"]},
          "then": {"not": {"anyOf": [{"required": ["graph_invalidation"]}, {"required": ["memory_finalization"]}, {"required": ["graph_finalization"]}]}}
        },
        {
          "if": {"required": ["memory_excluded"]},
          "then": {"properties": {"memory_excluded": {"const": true}}, "required": ["memory_purge"]}
        },
        {
          "if": {"required": ["comparison_pending_completion_id", "comparison_emitted_completion_id"]},
          "then": false
        }
      ]
    },
    "escalation_question": {
      "type": "string"
    },
    "dependency_checks": {
      "type": "object",
      "description": "Dependency availability checks keyed by dependency name.",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "available",
              "unavailable",
              "timeout",
              "incompatible"
            ]
          },
          "checked_at": {
            "type": "string",
            "format": "date-time"
          },
          "error_code": {
            "type": [
              "string",
              "null"
            ]
          },
          "version": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "status",
          "checked_at"
        ]
      },
      "default": {}
    },
    "fallback_mode": {
      "type": "boolean",
      "description": "True when a required dependency is unavailable and fallback behavior is active.",
      "default": false
    },
    "execution_mode": {
      "type": "string",
      "enum": [
        "standard",
        "manual_specification"
      ],
      "default": "standard"
    },
    "dependency_fallbacks": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "quality_degradation": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "dependency": {
            "type": "string"
          },
          "affected_artifacts": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "degradation_type": {
            "type": "string",
            "enum": [
              "unvalidated"
            ]
          }
        },
        "required": [
          "dependency",
          "affected_artifacts",
          "degradation_type"
        ]
      },
      "default": []
    },
    "recovery_mode": {
      "type": "boolean",
      "description": "True while the run is executing with recovered KB files.",
      "default": false
    },
    "phase_timings": {
      "type": "object",
      "description": "Timing telemetry captured for each phase transition.",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "start_ts": {
            "type": "string",
            "format": "date-time"
          },
          "end_ts": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "elapsed_seconds": {
            "type": "number",
            "minimum": 0
          },
          "budget_seconds": {
            "type": "number",
            "minimum": 0
          },
          "over_budget": {
            "type": "boolean"
          },
          "anomaly_reason": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "start_ts"
        ]
      },
      "default": {}
    },
    "checkpoints": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "phase": {
            "type": "string"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "decision": {
            "enum": [
              "PASS",
              "KILL",
              "DEFER",
              "SKIP"
            ]
          },
          "auto_defaulted": {
            "type": "boolean"
          }
        }
      }
    },
    "rework_iteration_count": {
      "type": "integer",
      "minimum": 0,
      "default": 0
    },
    "fallback_to_full_cycle": {
      "type": "boolean",
      "default": false
    },
    "escalation_reason": {
      "type": [
        "string",
        "null"
      ],
      "default": null
    },
    "change_resolution": {
      "type": "object",
      "properties": {
        "reentry_target": {
          "type": "string",
          "enum": [
            "BUILD_RESTART",
            "QA_RESTART"
          ]
        }
      }
    },
    "split_metrics": {
      "type": "object",
      "description": "BUILD/QA split workflow metrics. Initialized to zero on each new run.",
      "properties": {
        "fallback_count": { "type": "integer", "default": 0 },
        "qa_coverage": { "type": "number", "default": 0.0 },
        "rework_count": { "type": "integer", "default": 0 }
      }
    },
    "last_dispatch": {
      "type": ["object", "null"],
      "description": "Written by COMMANDER immediately before dispatching an agent and updated after Post-Dispatch Protocol completes. Used for compaction recovery — if post_dispatch_complete is false after compaction, the dispatch interrupted and journal writes must be verified.",
      "default": null,
      "properties": {
        "agent": {
          "type": "string",
          "description": "Agent name dispatched (e.g. SYNTHESIZER)"
        },
        "dispatched_at": {
          "type": "string",
          "format": "date-time",
          "description": "UTC timestamp when the dispatch was issued"
        },
        "post_dispatch_complete": {
          "type": "boolean",
          "description": "Set to true only after Post-Dispatch Protocol Steps A-C all complete successfully. If false after compaction, the last dispatch was interrupted."
        },
        "journal_entries_written": {
          "type": "array",
          "description": "IDs of journal entries written during Post-Dispatch Protocol (e.g. [\"RJ-012\", \"RJ-013\"]). Empty if post_dispatch_complete is false.",
          "items": { "type": "string" }
        }
      },
      "required": ["agent", "dispatched_at", "post_dispatch_complete", "journal_entries_written"]
    },
    "spec_status": {
      "type": "string",
      "enum": ["draft", "planned", "in-progress", "implemented"],
      "default": "draft",
      "description": "Lifecycle status of the specification driven by this run."
    },
    "requires_human_review": {
      "type": "boolean",
      "default": false,
      "description": "Set to true when banzai mode detects major intent drift that requires post-run human review."
    },
    "constitution_amendments_pending": {
      "type": "integer",
      "minimum": 0,
      "default": 0,
      "description": "Count of [PROPOSED] amendment blocks appended to constitution.md awaiting human review."
    },
    "build": {
      "type": "object",
      "description": "Build phase tracking state.",
      "properties": {
        "completed_tasks": { "type": "integer", "minimum": 0, "default": 0 },
        "total_tasks": { "type": "integer", "minimum": 0, "default": 0 },
        "tasks_completed_pct": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "description": "Percentage of tasks completed, recomputed after each task."
        },
        "current_task": { "type": "string" },
        "task_results": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "status": { "type": "string" },
              "review_cycles": { "type": "integer" },
              "degraded": { "type": "boolean" },
              "spec_guard": { "type": "string" },
              "code_review": { "type": "string" },
              "test_guardian": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
