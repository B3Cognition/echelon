#!/usr/bin/env bash
# Keep origin pushes verified locally.  A clean, single-ref fast-forward push to
# main may reuse an exact merge-verification receipt or run the selector; every
# other shape retains the comprehensive test runner.
set -euo pipefail

remote="${1:-}"
url="${2:-}"

if [[ "$remote" != "origin" ]]; then
  printf 'Echelon pre-push: skipping test gate for remote "%s".\n' "${remote:-<unknown>}"
  exit 0
fi

repo_root="$(git rev-parse --show-toplevel)"
runner="$repo_root/tests/run-all.sh"
selector="$repo_root/scripts/merge_verification.py"

python_exec="${PYTHON:-}"
if [[ -z "$python_exec" ]]; then
  if [[ -x "$repo_root/.venv/bin/python" ]]; then
    python_exec="$repo_root/.venv/bin/python"
  elif [[ -x "$HOME/.echelon/venv/bin/python" ]]; then
    python_exec="$HOME/.echelon/venv/bin/python"
  else
    python_exec="$(command -v python3 || true)"
  fi
fi

if [[ ! -f "$runner" ]]; then
  printf 'Echelon pre-push: missing test runner: %s\n' "$runner" >&2
  exit 1
fi

if [[ -z "$python_exec" || ! -x "$python_exec" ]] && ! command -v "$python_exec" >/dev/null 2>&1; then
  printf 'Echelon pre-push: no usable Python interpreter was found.\n' >&2
  exit 1
fi

run_full_suite() {
  local reason="$1"
  printf 'Echelon pre-push: running full test suite (%s).\n' "$reason"
  printf 'Command: bash tests/run-all.sh\n\n'
  cd "$repo_root"
  bash "$runner"
}

zero_sha="0000000000000000000000000000000000000000"
pushes=()
while IFS=' ' read -r local_ref local_sha remote_ref remote_sha; do
  [[ -n "${local_ref:-}" ]] || continue
  pushes+=("$local_ref|$local_sha|$remote_ref|$remote_sha")
done

if [[ "${#pushes[@]}" -ne 1 ]]; then
  run_full_suite "push does not contain exactly one ref update"
  exit $?
fi

IFS='|' read -r local_ref local_sha remote_ref remote_sha <<< "${pushes[0]}"

if [[ "$local_ref" != "refs/heads/main" || "$remote_ref" != "refs/heads/main" \
  || "$local_sha" == "$zero_sha" || "$remote_sha" == "$zero_sha" ]]; then
  run_full_suite "push is not a main-to-main branch update"
  exit $?
fi

if ! git rev-parse --verify --quiet "${local_sha}^{commit}" >/dev/null \
  || ! git rev-parse --verify --quiet "${remote_sha}^{commit}" >/dev/null; then
  run_full_suite "push commits are unavailable locally"
  exit $?
fi

head_sha="$(git rev-parse HEAD)"
if [[ "$local_sha" != "$head_sha" ]]; then
  run_full_suite "push candidate is not the checked-out HEAD"
  exit $?
fi

if [[ -n "$(git status --porcelain)" ]]; then
  run_full_suite "working tree is dirty"
  exit $?
fi

if ! git merge-base --is-ancestor "$remote_sha" "$local_sha"; then
  run_full_suite "main update is not a fast-forward"
  exit $?
fi

if [[ ! -f "$selector" ]]; then
  run_full_suite "merge-verification selector is unavailable"
  exit $?
fi

receipt_dir="$repo_root/tests/reports/merge-verification"
if [[ -d "$receipt_dir" ]]; then
  for receipt in "$receipt_dir"/*.json; do
    [[ -f "$receipt" ]] || continue
    if "$python_exec" "$selector" confirm-fast-forward --repo "$repo_root" --receipt "$receipt" >/dev/null 2>&1; then
      printf 'Echelon pre-push: reusing matching merge-verification receipt: %s\n' "${receipt#$repo_root/}"
      exit 0
    fi
  done
fi

printf 'Echelon pre-push: running selected verification for clean main fast-forward to %s (%s).\n' "$remote" "$url"
set +e
"$python_exec" "$selector" run --repo "$repo_root" --base "$remote_sha" --head "$local_sha"
selector_rc=$?
set -e

case "$selector_rc" in
  0)
    exit 0
    ;;
  1)
    printf 'Echelon pre-push: selected verification failed; push blocked.\n' >&2
    exit 1
    ;;
  *)
    run_full_suite "merge-verification selector could not run"
    ;;
esac
